# ==============================================================================
# CityRock POS Backend — Environment Configuration Template
# ==============================================================================
# For Local Development: Copy this file to .env in the backend/ folder
# For Vercel Deployment: Add these keys under Project Settings -> Environment Variables
# For Render Deployment: Add these keys under Service -> Environment Variables
# ==============================================================================

# Server Runtime & Port (Auto-detected: 5000 for local/Render, managed by Vercel on serverless)
PORT=5000
NODE_ENV=development

# MongoDB Connection String:
# - Local Dev: mongodb://localhost:27017/cityrock
# - Vercel / Render Production: Must use MongoDB Atlas cloud connection string:
#   mongodb+srv://<username>:<password>@<cluster>.mongodb.net/cityrock?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017/cityrock

# JWT Secret & Expiration
# In production, use a strong 64+ char random string (e.g. generated via `openssl rand -hex 32`)
JWT_SECRET=your_super_strong_random_jwt_secret_change_in_production
JWT_EXPIRES_IN=7d

# Frontend URL & CORS Whitelist (Comma-separated)
# In production on Vercel: set to your deployed frontend URL (e.g. https://cityrock-pos.vercel.app)
# Note: Any *.vercel.app domain is also auto-whitelisted by backend CORS!
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,https://cityrock-pos.vercel.app

# Super Admin Dynamic Credentials (Required for Admin Panel Login)
# The system dynamically verifies login against these values instead of the database.
SUPER_ADMIN_EMAIL=admin@cityrock.pk
SUPER_ADMIN_PASSWORD=change_this_super_admin_password_immediately

# Trial Duration Settings
# Supports flexible time formats: "14d" (14 days), "1m" (1 month), "20mins" (20 minutes), "1h" (1 hour)
TRIAL_DURATION=14d

# Cloudinary Storage for Product & Store Images (Optional for local, required for uploads)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
